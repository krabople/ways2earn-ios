{
  "expo": {
    "name": "Ways2Earn",
    "slug": "ways2earn-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ways2earn",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.krabople.ways2earn",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#102A46",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 118
        }
      ],
      ["expo-notifications", { "defaultChannel": "community-updates" }],
      ["expo-image-picker", { "photosPermission": "Allow Ways2Earn to choose an image for a community post or profile." }],
      ["expo-secure-store", { "configureAndroidBackup": true, "faceIDPermission": "Allow Ways2Earn to protect your signed-in session." }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
