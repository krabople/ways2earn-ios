{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_ORIGIN": "https://www.ways2earn.com" }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
